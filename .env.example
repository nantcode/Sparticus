# Copy this file to a new file named .env (in this same folder) and fill in YOUR OWN values.
# .env holds your keys: never send it to anyone, never put it on GitHub, never paste it in a chat.

# Alpaca: alpaca.markets -> Paper Trading account -> API Keys -> Generate. Use PAPER keys to start.
ALPACA_API_KEY=your-paper-api-key-id
ALPACA_SECRET_KEY=your-paper-secret-key

# Leave this as true. "false" means real money.
ALPACA_PAPER=true

# iex is free. Use sip only if you pay Alpaca for it.
ALPACA_DATA_FEED=iex

# Optional: a Discord webhook from YOUR OWN server (Server Settings -> Integrations -> Webhooks).
# Leave empty to run without Discord.
DISCORD_WEBHOOK_URL=
